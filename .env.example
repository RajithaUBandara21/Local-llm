# Copy to .env to override. Real environment variables take precedence over this file.

# Base URL of the Ollama server (no path)
OLLAMA_URL=http://localhost:11434

# SQLite file for batches and triage results (created on first use)
DATABASE_PATH=triage.db

# Gmail OAuth (feature 26b). Leave blank to keep Gmail connect disabled (503).
# Client id/secret come from a Google Cloud OAuth client (type: Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered on that OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/gmail/oauth/callback
# Symmetric key used to encrypt the stored Gmail refresh token. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GMAIL_TOKEN_ENCRYPTION_KEY=
# Where the OAuth callback redirects the browser back to after connect/error.
ADMIN_DASHBOARD_URL=http://localhost:3000/admin
